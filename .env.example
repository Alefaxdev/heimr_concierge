# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Valgfritt: hvilken Claude-modell (standard: claude-sonnet-4-6)
CONCIERGE_MODEL=

# Innlogging
# Lang tilfeldig streng, min 16 tegn. Lag f.eks. med:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Passord for resepsjonen (kan bare chatte)
STAFF_PASSWORD=
# Passord for concierge (chat + admin + «husk at…»)
CONCIERGE_PASSWORD=

# Mews (valgfritt – gir panelet «Dagens VIP-gjester»)
# Tokenene hentes fra Azure Key Vault, samme som Fabric-notebookene.
# Lokalt: kjør `az login` med en bruker som har lesetilgang til hemmeligheter i vaulten.
AZURE_KEY_VAULT_URL=https://heimr.vault.azure.net
# Navn på hemmelighetene i vaulten (endre hvis de heter noe annet):
MEWS_CLIENT_TOKEN_SECRET=mews-client-token
MEWS_ACCESS_TOKEN_SECRET=mews-access-token
# I produksjon (f.eks. Vercel): service principal med lesetilgang til vaulten
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
